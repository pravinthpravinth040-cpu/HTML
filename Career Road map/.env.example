# Supabase Database & Auth Configuration
# Replace these with your real project keys from https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Direct AI Assistant Key (OpenAI or Gemini)
# Users can also enter this directly in the AI Assistant settings modal in the app UI
VITE_OPENAI_API_KEY=
VITE_GEMINI_API_KEY=
